# Environment variables for deploy/docker-compose.yml
# Copy this file to deploy/.env and edit as needed:
#   cp deploy/.env.example deploy/.env
#
# REQUIRED: compose refuses to start without FREECAD_*_IMAGE set here.
# Use the same values for local build, compose up, and registry push.

# =============================================================================
# Image tags (registry strategy)
# =============================================================================
#
# Tag policy (see just docker::publish-show):
#
#   dev          Mutable fast-iteration tag. Downstream pins :dev forever;
#                you overwrite it with `just docker::publish-dev` after each change.
#                Deploy: docker compose pull && docker compose up -d --no-build
#
#   X.Y.Z        Immutable release tag. Push with `just docker::publish 1.0.0`.
#                Downstream production should pin a specific semver (or digest).
#
#   sha-abc1234  Optional CI traceability tag (not required for compose).
#
# Docker Hub (personal fork example — namespace zhuxiaohai):
# Compose build and registry push use THE SAME tag (one image ID locally and on Hub).
FREECAD_BRIDGE_IMAGE=zhuxiaohai/freecad-bridge:dev
FREECAD_MCP_IMAGE=zhuxiaohai/freecad-robust-mcp:dev
#
# Dev workflow (see just docker::publish-show):
#   just docker::compose-build-mcp    # build → zhuxiaohai/...:dev locally
#   just docker::compose-up             # run without rebuild
#   just docker::publish-push-mcp       # push same tag to Hub (no second build)
#   just docker::publish-dev            # build + push both
#   just docker::clean-legacy-tags      # remove old freecad-*:latest images
#
# GHCR alternative — set full image paths here (not via shell exports):
# FREECAD_BRIDGE_IMAGE=ghcr.io/zhuxiaohai/freecad-bridge:dev
# FREECAD_MCP_IMAGE=ghcr.io/zhuxiaohai/freecad-robust-mcp:dev
#
# Immutable release example:
# FREECAD_BRIDGE_IMAGE=zhuxiaohai/freecad-bridge:1.0.0
# FREECAD_MCP_IMAGE=zhuxiaohai/freecad-robust-mcp:1.0.0
#
# Local build only (no registry):
# FREECAD_BRIDGE_IMAGE=freecad-bridge:latest
# FREECAD_MCP_IMAGE=freecad-robust-mcp:latest

# =============================================================================
# FreeCAD version (used by Dockerfile.freecad-bridge build arg)
# =============================================================================
# Must match the Python version bundled by FreeCAD (currently 3.11 = FreeCAD 1.1.x).
# See CLAUDE.md "Critical: Python Version Must Match FreeCAD".
FREECAD_TAG=1.1.1

# =============================================================================
# Port bindings
# =============================================================================
# MCP HTTP port exposed on the host (default 8000).
# Change if port 8000 is already in use on the host.
FREECAD_MCP_PORT=8000
