# Environment variables for deploy/docker-compose.yml
# Copy this file to deploy/.env and edit as needed:
#   cp deploy/.env.example deploy/.env

# =============================================================================
# Image tags
# =============================================================================
# Leave blank to always build from local source (docker compose up --build).
# Set to a registry image tag for production deployments:
#   FREECAD_BRIDGE_IMAGE=registry.cn-shanghai.aliyuncs.com/designorder/freecad-bridge:1.0.0
#   FREECAD_MCP_IMAGE=registry.cn-shanghai.aliyuncs.com/designorder/freecad-robust-mcp:1.0.0

FREECAD_BRIDGE_IMAGE=freecad-bridge:latest
FREECAD_MCP_IMAGE=freecad-robust-mcp:latest

# =============================================================================
# FreeCAD version (used by Dockerfile.freecad-bridge build arg)
# =============================================================================
# Must match the Python version bundled by FreeCAD (currently 3.11 = FreeCAD 1.1.x).
# See CLAUDE.md "Critical: Python Version Must Match FreeCAD".
FREECAD_TAG=1.1.1

# =============================================================================
# Port bindings
# =============================================================================
# MCP HTTP port exposed on the host (default 8000).
# Change if port 8000 is already in use on the host.
FREECAD_MCP_PORT=8000
