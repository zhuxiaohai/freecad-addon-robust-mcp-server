# Environment variables for deploy/docker-compose.yml
# Copy this file to deploy/.env and edit as needed:
#   cp deploy/.env.example deploy/.env
#
# REQUIRED: compose refuses to start without FREECAD_*_IMAGE set here.
# Use the same values for local build, compose up, and registry push.

# =============================================================================
# Image tags (registry strategy)
# =============================================================================
#
# Tag policy (see just docker::publish-show):
#
#   dev          Mutable fast-iteration tag. Downstream pins :dev forever;
#                you overwrite it with `just docker::publish-dev` after each change.
#                Deploy: docker compose pull && docker compose up -d --no-build
#
#   X.Y.Z        Immutable release tag. Push with `just docker::publish 1.0.0`.
#                Downstream production should pin a specific semver (or digest).
#
# Corporate registry (DesignOrder / Jenkins / K8s):
#   freecad-bridge image is built in service_freecad_bridge repo (Jenkins, dev branch).
#   freecad-robust-mcp image is built in THIS repo (Jenkins, dev branch).
FREECAD_BRIDGE_IMAGE=hub.designorder.cn/freecad-bridge:dev
FREECAD_MCP_IMAGE=hub.designorder.cn/freecad-robust-mcp:dev
#
# Dev workflow (MCP image — this repo):
#   docker login hub.designorder.cn
#   just docker::compose-build-mcp    # build → hub.designorder.cn/...:dev locally
#   just docker::compose-pull-bridge  # pull bridge from registry (or build in bridge repo)
#   just docker::compose-up             # run without rebuild
#   just docker::publish-push-mcp       # push same tag to registry
#   just docker::publish-dev            # build + push MCP only
#
# Personal Docker Hub alternative:
# FREECAD_BRIDGE_IMAGE=zhuxiaohai/freecad-bridge:dev
# FREECAD_MCP_IMAGE=zhuxiaohai/freecad-robust-mcp:dev
#
# Local build only (no registry):
# FREECAD_BRIDGE_IMAGE=freecad-bridge:latest
# FREECAD_MCP_IMAGE=freecad-robust-mcp:latest

# =============================================================================
# Base image registry (Dockerfile FROM lines)
# =============================================================================
# Corporate mirror prefix for python:3.11-alpine.
# Set empty to pull base images from Docker Hub instead.
DOCKER_REGISTRY=hub.designorder.cn/

# Alpine apk mirror (dl-cdn.alpinelinux.org). MCP image uses Alpine, not Ubuntu — use APK_MIRROR, not APT_MIRROR.
# Set empty to use default Alpine CDN.
APK_MIRROR=https://mirrors.aliyun.com/alpine/

# PyPI mirror for pip/uv during Docker build. Set empty to use pypi.org.
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# =============================================================================
# FreeCAD version (bridge image — informational; bridge built in service_freecad_bridge)
# =============================================================================
FREECAD_TAG=1.1.1

# =============================================================================
# Port bindings
# =============================================================================
# MCP HTTP port exposed on the host (default 8000).
# Change if port 8000 is already in use on the host.
FREECAD_MCP_PORT=8000
